{
  "name": "inventory-api",
  "version": "1.0.0",
  "description": "Inventory API \u2014 REST service for tracking stock items.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "// prestart": "dist/ is not committed, so a fresh clone must compile before it can start; npm runs this automatically.",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run typecheck"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
