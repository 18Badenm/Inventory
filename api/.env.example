# Copy to .env and adjust. Every value has a safe default; nothing here is secret.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./inventory.db
LOG_LEVEL=info

# Valuation (optional). Without GEMINI_API_KEY the server still boots and
# POST /v1/items/:id/valuation returns 503 valuation_not_configured.
# Put the real key in api/.env, which is gitignored. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
VALUATION_CURRENCY=USD
