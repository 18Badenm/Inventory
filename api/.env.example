# Copy to .env and adjust.
#
# Every value below has a safe default EXCEPT GEMINI_API_KEY, which is a
# credential: it has no default, it must never be committed, and .env is
# gitignored for that reason.
#
# Nothing in this service auto-loads .env. Pass it explicitly:
#   node --env-file=.env dist/server.js
# or export the variables into the environment yourself.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./inventory.db
LOG_LEVEL=info

# --- Item valuation (POST /v1/items/:id/valuation) -------------------------
# SECRET. Without it the service still boots and serves every other route;
# the valuation endpoint reports 503 valuation_not_configured.
GEMINI_API_KEY=

# Model IDs are retired on Google's schedule. `gemini-2.5-flash` is still
# listed by the models endpoint but already refuses new callers, so if
# valuation starts returning 502 with upstreamStatus 404, list the models the
# key can reach and set a current one here:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash

# Bounds the whole call, retry included. Observed latency is 2-3 s.
GEMINI_TIMEOUT_MS=20000

# `on` grounds the price on live Google Search results and returns their URLs.
# It requires search-grounding quota on the key — a billed feature. Without
# that quota every grounded call fails with a hard 429, surfacing as 502
# valuation_upstream_failed, so set `off` to trade the citations for an
# unsourced estimate.
VALUATION_GROUNDING=on

# ISO-4217. The model is required to answer in this currency; a price quoted
# in any other is rejected rather than converted at a guessed rate.
VALUATION_CURRENCY=USD
